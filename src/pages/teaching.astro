---
import BaseLayout from '../layouts/BaseLayout.astro';

type Course = { title: string; href: string; role: string; description?: string };

const courseGuides = 'https://www.lse.ac.uk/resources/calendar/courseGuides/EC';

const courses: Course[] = [
    {
        title: 'EC1B5 Macroeconomics',
        href: `${courseGuides}/2026_EC1B5.htm`,
        role: 'Course Manager and Teacher (2023-2024 to 2025-2026)',
        description:
            'Managed the teaching team and day-to-day administration of this undergraduate course, which has approximately 250 students each year. Taught weekly classes for 60–80 students and delivered the annual revision lecture to the full cohort.'
    },
    {
        title: 'EC402 Econometrics',
        href: `${courseGuides}/2026_EC402.htm`,
        role: 'Teaching Fellow (2023-2024, 2024-2025)'
    },
    {
        title: 'EC400 Introductory Course in Mathematics and Statistics',
        href: `${courseGuides}/2026_EC400.htm`,
        role: 'Graduate Teaching Assistant (2023-2024 to 2025-2026)'
    },
    {
        title: 'EC2C1 Econometrics II (formerly EC220 Introduction to Econometrics)',
        href: `${courseGuides}/2026_EC2C1.htm`,
        role: 'Graduate Teaching Assistant (2021-2022, 2022-2023)'
    }
];
---

<BaseLayout title="Teaching" description="These are all the courses I have taught" showHeader={false}>
    <div class="mb-16 sm:mb-24">
        <h1 class="mb-12 text-2xl leading-tight font-serif italic sm:mb-16 sm:text-4xl">Teaching</h1>
        <ul class="flex flex-col gap-8">
            {
                courses.map((course) => (
                    <li>
                        <h2 class="text-xl leading-tight font-serif font-semibold sm:text-2xl text-accent dark:text-accent-200">
                            <a class="underline decoration-1 underline-offset-4" href={course.href} target="_blank" rel="noopener noreferrer">
                                {course.title}
                            </a>
                        </h2>
                        <p class="py-2 text-sm italic">{course.role}</p>
                        {course.description && <p class="text-sm leading-normal text-justify">{course.description}</p>}
                    </li>
                ))
            }
        </ul>
    </div>
</BaseLayout>

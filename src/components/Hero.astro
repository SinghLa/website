---
import Button from './Button.astro';
import siteConfig from '../data/site-config';

const hero = siteConfig.hero;
---

{
    (hero?.title || hero?.image?.src || (hero?.actions && hero.actions.length > 0)) && (
        <div class="w-full flex flex-col md:flex-row md:items-start gap-8 md:gap-10">
            <div class="shrink-0 flex flex-col items-center text-center gap-6 w-full max-w-[300px] mx-auto md:items-start md:text-left md:mx-0 md:w-64 lg:w-[300px] md:sticky md:top-24">
                {hero.image?.src && (
                    <figure class="w-44 md:w-full">
                        <img
                            class="w-full aspect-square object-cover rounded-full"
                            src={hero.image.src}
                            loading="eager"
                            fetchpriority="high"
                            decoding="async"
                            alt={hero.image.alt || ''}
                        />
                    </figure>
                )}
                <div>
                    <p class="text-2xl leading-tight font-serif font-medium sm:text-3xl">{siteConfig.title}</p>
                    <p class="text-sm leading-tight mt-1">PhD candidate, LSE</p>
                </div>
                {hero.actions && hero.actions.length > 0 && (
                    <div class="flex flex-wrap justify-center gap-4 md:justify-start">
                        {hero.actions.map((action) => (
                            <Button href={action.href} {...(action.href.endsWith('.pdf') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
                                {action.text}
                            </Button>
                        ))}
                    </div>
                )}
            </div>
            <div class="flex flex-col min-w-0 flex-1">
                <div class="flex flex-col gap-6 mb-16 sm:mb-24">
                <h1 class="text-2xl leading-tight font-serif italic sm:text-4xl text-accent dark:text-accent-200">Hi, I’m Lachi!</h1>
                <div class="max-w-none prose prose-dante sm:prose-lg">
                    <p>
                        I am a PhD candidate in Economics at the London School of Economics (LSE). I work in development, labour and environmental economics.
                    </p>
                    <p>
                        I study informal labour markets in developing countries. I ask how workers choose where to relocate under formalization policies, and how
                        they adapt to extreme weather. I enjoy building new structured data to answer hard questions.
                    </p>
                    <p>
                        I am affiliated with{' '}
                        <a href="https://sticerd.lse.ac.uk/" target="_blank" referrerpolicy="no-referrer">STICERD</a>,{' '}
                        <a href="https://cep.lse.ac.uk/" target="_blank" referrerpolicy="no-referrer">CEP</a> (Labour Programme), Economics of Environment and
                        Energy (EEE), and the{' '}
                        <a href="https://cssh.northeastern.edu/gap/" target="_blank" referrerpolicy="no-referrer">Global Action for Policy (GAP) Initiative</a> at
                        Northeastern University.
                    </p>
                    <p>
                        I am from Ranchi, a city in Jharkhand, India. I hold a BA (Hons) in Economics from{' '}
                        <a href="https://www.mirandahouse.ac.in/" target="_blank" referrerpolicy="no-referrer">Miranda House</a>, University of Delhi, and an MA
                        in International and Development Economics from{' '}
                        <a href="https://economics.yale.edu/international-and-development-economics" target="_blank" referrerpolicy="no-referrer">Yale</a>.
                        Before the PhD, I was a pre-doctoral fellow at Yale’s{' '}
                        <a href="https://tobin.yale.edu/" target="_blank" referrerpolicy="no-referrer">Tobin Center for Economic Policy</a>.
                    </p>
                </div>
                {hero.image?.caption && (
                    <p class="text-xl leading-tight font-serif font-semibold sm:text-2xl text-accent dark:text-accent-200">{hero.image.caption}</p>
                )}
                </div>
                <slot />
            </div>
        </div>
    )
}

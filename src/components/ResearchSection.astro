---
import ProjectItem from './ProjectItem.astro';
import { getAllProjects } from '../utils/data-utils';

const { published, workingPaper, workInProgress } = await getAllProjects();
const headingClass = 'mb-12 text-2xl leading-tight font-serif italic sm:mb-16 sm:text-4xl';
---

<section id="research" class="scroll-mt-24 md:scroll-mt-[146px] mb-16 sm:mb-24" data-nav-section>
    {
        published.length > 0 && (
            <div class="mb-16">
                <h2 class={headingClass}>Publications</h2>
                <ul class="flex flex-col gap-8">
                    {published.map((project) => (
                        <li>
                            <ProjectItem project={project} />
                        </li>
                    ))}
                </ul>
            </div>
        )
    }
    {
        workingPaper.length > 0 && (
            <div>
                <h2 class={headingClass}>Working Papers</h2>
                <ul class="flex flex-col gap-8">
                    {workingPaper.map((project) => (
                        <li>
                            <ProjectItem project={project} />
                        </li>
                    ))}
                </ul>
            </div>
        )
    }
    {
        workInProgress.length > 0 && (
            <div class="mt-16">
                <h2 class={headingClass}>Work In Progress</h2>
                <ul class="flex flex-col gap-8">
                    {workInProgress.map((project) => (
                        <li>
                            <ProjectItem project={project} />
                        </li>
                    ))}
                </ul>
            </div>
        )
    }
</section>
